+# WORK_QUEUE_STOP_GATE (patch by Hermes; see /opt/data/patches).
+# Scope: only this session's open items plus global open items gate the turn.
+# blocked items never gate. Off when /opt/data/work_queue_gate.disabled exists.
+def _work_queue_stop_nudge(agent) -> Optional[str]:
+    import os
+    import subprocess
+    import time as _t
+    if os.path.exists("/opt/data/work_queue_gate.disabled"):
+        return None
+    sid = str(getattr(agent, "session_id", "") or "")
+    cmd = ["python3", "-I", "/opt/data/scripts/workqueue.py", "check"]
+    if sid:
+        cmd += ["--session", sid]
+    try:
+        r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
+    except Exception:
+        logger.debug("work queue check failed", exc_info=True)
+        return None
+    items = [l for l in (r.stdout or "").splitlines() if l.startswith("#")]
+    nudge = r.returncode != 0 and getattr(agent, "_work_queue_nudges", 0) < 10
+    try:
+        with open("/opt/data/gate_call.log", "a", encoding="utf-8") as f:
+            f.write("%s GATE sid=%s open=%s nudge=%s\n" % (
+                _t.strftime("%Y-%m-%dT%H:%M:%S"), sid or "-",
+                ",".join(l.split()[0] for l in items) or "none", nudge))
+    except Exception:
+        pass
+    if not nudge:
+        return None
+    agent._work_queue_nudges = getattr(agent, "_work_queue_nudges", 0) + 1
+    causes = " ".join(l.split()[0] for l in items)
+    return (
+        "[System note: the work queue still has unfinished items for this session. "
+        "Cause items: " + causes + ". Do the next item now instead of ending with a plan. "
+        "Open items:\n" + "\n".join(items) + "]"
+    )
+
+
 def apply_stop_gates(
     agent: Any, final_msg: dict[str, Any], *, final_response: Any, messages: list[dict[str, Any]],
     conversation_history: Any, pending_verification_response: Any,
@@ -175,6 +213,32 @@
             pending_verification_response_previewed=agent._interim_content_was_streamed(final_response or ""),
         )
 
