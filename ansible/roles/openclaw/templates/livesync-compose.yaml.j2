name: livesync-cli

services:
  livesync-cli:
    image: "{{ openclaw_runtime.config.livesync_image }}"
    container_name: livesync-cli
    restart: unless-stopped
    user: "{{ openclaw_runtime.config.livesync_user }}"
    entrypoint: [/bin/sh, -c]
    command:
      - |
        if [ -z "$(find /vault -type f -name '*.md' -print -quit)" ]; then
          echo 'Vault is missing or empty; refusing to start LiveSync.' >&2
          exit 1
        fi
        exec livesync-cli --vault /vault daemon
    environment:
      LIVESYNC_DB_PATH: /data
    volumes:
      - type: bind
        source: "{{ openclaw_runtime.config.vault_path }}"
        target: /vault
        bind:
          create_host_path: false
      - type: bind
        source: "{{ openclaw_runtime.config.livesync_data }}"
        target: /data
        bind:
          create_host_path: false
